{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "System.Net.Http.HttpClient": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "Claude": {
    "Models": {
      "Fast": "claude-haiku-4-5",
      "Smart": "claude-sonnet-5-5"
    },
    "MaxTokens": 1024,
    "Pricing": {
      "claude-haiku-4-5": {
        "InputPerMTok": 1,
        "OutputPerMTok": 5
      },
      "claude-sonnet-5-5": {
        "InputPerMTok": 2,
        "OutputPerMTok": 10
      },
      "claude-opus-5-5": {
        "InputPerMTok": 4,
        "OutputPerMTok": 20
      }
    }
  },
  "Auth": {
    "DevSignIn": {
      "Enabled": false
    }
  },
  "Database": {
    "Provider": "Sqlite"
  },
  "ConnectionStrings": {
    "JobScout": "Data Source=jobscout.db"
  }
}
