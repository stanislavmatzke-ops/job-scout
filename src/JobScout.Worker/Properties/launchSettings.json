{
  "$schema": "https://json.schemastore.org/launchsettings.json",
  "profiles": {
    "JobScout.Worker": {
      "commandName": "Project",
      "dotnetRunMessages": true,
      "environmentVariables": {
        "DOTNET_ENVIRONMENT": "Development"
      }
    },
    "JobScout.Worker (invite)": {
      "commandName": "Project",
      "dotnetRunMessages": true,
      "commandLineArgs": "--Scout:Mode=invite --Scout:InviteNote=Stanislav-test",
      "environmentVariables": {
        "DOTNET_ENVIRONMENT": "Development"
      }
    },
    "JobScout.Worker (samples)": {
      "commandName": "Project",
      "dotnetRunMessages": true,
      "commandLineArgs": "--Scout:DataDir=samples",
      "environmentVariables": {
        "DOTNET_ENVIRONMENT": "Development"
      }
    },
    "JobScout.Worker (search private)": {
      "commandName": "Project",
      "dotnetRunMessages": true,
      "commandLineArgs": "--Scout:Mode=search --Scout:OpenReport=true",
      "environmentVariables": {
        "DOTNET_ENVIRONMENT": "Development"
      }
    },
    "JobScout.Worker (search autolakyrnik)": {
      "commandName": "Project",
      "commandLineArgs": "--Scout:Persona=autolakyrnik --Scout:Mode=search",
      "environmentVariables": { "DOTNET_ENVIRONMENT": "Development" }
    },
    "JobScout.Worker (search zednik)": {
      "commandName": "Project",
      "commandLineArgs": "--Scout:Persona=zednik --Scout:Mode=search",
      "environmentVariables": { "DOTNET_ENVIRONMENT": "Development" }
    }
  }
}