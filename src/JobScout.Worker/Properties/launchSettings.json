{
  "$schema": "https://json.schemastore.org/launchsettings.json",
  "profiles": {
    "JobScout.Worker": {
      "commandName": "Project",
      "dotnetRunMessages": true,
      "environmentVariables": {
        "DOTNET_ENVIRONMENT": "Development"
      }
    },
    "JobScout.Worker (samples)": {
      "commandName": "Project",
      "dotnetRunMessages": true,
      "commandLineArgs": "--Scout:DataDir=samples",
      "environmentVariables": {
        "DOTNET_ENVIRONMENT": "Development"
      }
    },
    "JobScout.Worker (search test)": {
      "commandName": "Project",
      "dotnetRunMessages": true,
      "commandLineArgs": "--Scout:Mode=search",
      "environmentVariables": {
        "DOTNET_ENVIRONMENT": "Development"
      }
    },
    "JobScout.Worker (persona autolakyrnik)": {
      "commandName": "Project",
      "commandLineArgs": "--Scout:Persona=autolakyrnik",
      "environmentVariables": {
        "DOTNET_ENVIRONMENT": "Development"
      }
    },
    "JobScout.Worker (persona zednik)": {
      "commandName": "Project",
      "commandLineArgs": "--Scout:Persona=zednik",
      "environmentVariables": {
        "DOTNET_ENVIRONMENT": "Development"
      }
    }
  }
}